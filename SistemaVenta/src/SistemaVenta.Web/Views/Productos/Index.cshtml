@model IReadOnlyList<SistemaVenta.Application.DTOs.Productos.ProductoListadoDto>

@{
    ViewData["Title"] = "Productos";
}

<h1>Productos</h1>

<a asp-action="Crear"
   class="btn btn-primary mb-3">
    Nuevo producto
</a>

<table class="table">
    <thead>
        <tr>
            <th>Código</th>
            <th>Producto</th>
            <th>Categoría</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var producto in Model)
        {
            <tr>
                <td>@producto.CodigoInterno</td>
                <td>@producto.Nombre</td>
                <td>@producto.Categoria</td>
                <td>@producto.PrecioVenta.ToString("N2")</td>
                <td>@producto.StockActual</td>
                <td>@producto.Estado</td>
                <td>
                    <a asp-action="IngresarStock"
                       asp-route-id="@producto.Id"
                       class="btn btn-sm btn-outline-primary">
                        Ingresar stock
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>