@model IReadOnlyList<SistemaVenta.Application.DTOs.Productos.ProductoListadoDto>

@using SistemaVenta.Web.Security

@{
    ViewData["Title"] = "Productos";

    bool esAdministrador = User.IsInRole(Roles.Administrador);
}

<h1>Productos</h1>

@if (TempData["MensajeExito"] is string mensajeExito)
{
    <div class="alert alert-success" role="alert">
        @mensajeExito
    </div>
}

@if (TempData["MensajeError"] is string mensajeError)
{
    <div class="alert alert-danger" role="alert">
        @mensajeError
    </div>
}

@if (esAdministrador)
{
    <a asp-action="Crear"
       class="btn btn-primary mb-3">
        Nuevo producto
    </a>
}

<table class="table">
    <thead>
        <tr>
            <th>Código</th>
            <th>Producto</th>
            <th>Categoría</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var producto in Model)
        {
            <tr>
                <td>@producto.CodigoInterno</td>
                <td>@producto.Nombre</td>
                <td>@producto.Categoria</td>
                <td>@producto.PrecioVenta.ToString("N2")</td>
                <td>@producto.StockActual</td>
                <td>@producto.Estado</td>

                <td>
                    @if (esAdministrador)
                    {
                        @if (producto.Estado == "Activo")
                        {
                            <a asp-action="IngresarStock"
                               asp-route-id="@producto.Id"
                               class="btn btn-sm btn-outline-primary">
                                Ingresar stock
                            </a>
                        }

                        <a asp-action="Editar"
                           asp-route-id="@producto.Id"
                           class="btn btn-sm btn-outline-secondary">
                            Editar
                        </a>

                        @if (producto.Estado == "Activo")
                        {
                            <form asp-action="Desactivar"
                                  asp-route-id="@producto.Id"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-outline-warning">
                                    Desactivar
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Activar"
                                  asp-route-id="@producto.Id"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-outline-success">
                                    Activar
                                </button>
                            </form>
                        }

                        <form asp-action="Eliminar"
                              method="post"
                              class="d-inline"
                              onsubmit="return confirm('¿Estás seguro de que querés eliminar este producto? Esta acción no se puede deshacer.');">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@producto.Id" />

                            <button type="submit"
                                    class="btn btn-sm btn-outline-danger">
                                Eliminar
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
