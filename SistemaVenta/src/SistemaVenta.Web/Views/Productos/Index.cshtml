@model IReadOnlyList<SistemaVenta.Application.DTOs.Productos.ProductoListadoDto>

@using SistemaVenta.Web.Security

@{
    ViewData["Title"] = "Productos";

    bool esAdministrador = User.IsInRole(Roles.Administrador);
}

<h1>Productos</h1>

@if (TempData["MensajeExito"] is string mensajeExito)
{
    <div class="alert alert-success" role="alert">
        @mensajeExito
    </div>
}

@if (TempData["MensajeError"] is string mensajeError)
{
    <div class="alert alert-danger" role="alert">
        @mensajeError
    </div>
}

@if (esAdministrador)
{
    <a asp-action="Crear"
       class="btn btn-primary mb-3">
        Nuevo producto
    </a>
}

<div class="mb-3">
    <label for="buscadorProductos" class="form-label">
        Buscar producto
    </label>

    <input type="search"
           id="buscadorProductos"
           class="form-control"
           placeholder="Buscar por nombre, código o categoría..."
           autocomplete="off" />
</div>

<table class="table" id="tablaProductos">
    <thead>
        <tr>
            <th>Código</th>
            <th>Producto</th>
            <th>Categoría</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var producto in Model)
        {
            <tr>
                <td>@producto.CodigoInterno</td>
                <td>@producto.Nombre</td>
                <td>@producto.Categoria</td>
                <td>@producto.PrecioVenta.ToString("N2")</td>
                <td>@producto.StockActual</td>
                <td>@producto.Estado</td>

                <td>
                    @if (esAdministrador)
                    {

                        <a asp-controller="Productos"
                           asp-action="CodigoBarras"
                           asp-route-id="@producto.Id"
                           class="btn btn-sm btn-outline-dark mb-1">

                            Código de barras

                        </a>

                        @if (producto.Estado == "Activo")
                        {
                            <a asp-action="IngresarStock"
                               asp-route-id="@producto.Id"
                               class="btn btn-sm btn-outline-primary">
                                Ingresar stock
                            </a>
                        }

                        <a asp-action="Editar"
                           asp-route-id="@producto.Id"
                           class="btn btn-sm btn-outline-secondary">
                            Editar
                        </a>

                        @if (producto.Estado == "Activo")
                        {
                            <form asp-action="Desactivar"
                                  asp-route-id="@producto.Id"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-outline-warning">
                                    Desactivar
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Activar"
                                  asp-route-id="@producto.Id"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-outline-success">
                                    Activar
                                </button>
                            </form>
                        }

                        <form asp-action="Eliminar"
                              method="post"
                              class="d-inline"
                              onsubmit="return confirm('¿Estás seguro de que querés eliminar este producto? Esta acción no se puede deshacer.');">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@producto.Id" />

                            <button type="submit"
                                    class="btn btn-sm btn-outline-danger">
                                Eliminar
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    
    
        <tr id="sinResultados" style="display: none;">
            <td colspan="7" class="text-center text-muted py-4">
                No se encontraron productos que coincidan con la búsqueda.
            </td>
        </tr>
    </tbody>
</table>


@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const buscador = document.getElementById("buscadorProductos");
            const tabla = document.getElementById("tablaProductos");
            const filas = tabla.querySelectorAll("tbody tr:not(#sinResultados)");
            const sinResultados = document.getElementById("sinResultados");

            buscador.addEventListener("input", function () {

                const texto = buscador.value
                    .trim()
                    .toLocaleLowerCase();

                let encontrados = 0;

                filas.forEach(function (fila) {

                    const codigo = fila.cells[0].textContent.toLocaleLowerCase();
                    const nombre = fila.cells[1].textContent.toLocaleLowerCase();
                    const categoria = fila.cells[2].textContent.toLocaleLowerCase();

                    const coincide =
                        codigo.includes(texto) ||
                        nombre.includes(texto) ||
                        categoria.includes(texto);

                    fila.style.display = coincide ? "" : "none";

                    if (coincide) {
                        encontrados++;
                    }
                });

                sinResultados.style.display =
                    encontrados === 0 ? "" : "none";
            });
        });
    </script>
}

