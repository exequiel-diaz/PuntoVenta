@model IReadOnlyList<SistemaVenta.Application.DTOs.Productos.ProductoListadoDto>

@{
    ViewData["Title"] = "Alertas de stock";

    var sinStock = Model.Count(p => p.EstadoStock == "SinStock");

    var stockBajo = Model.Count(p => p.EstadoStock == "StockBajo");
}

<h2 class="mb-4">Alertas de stock</h2>

<p class="text-muted">
    Productos que necesitan reposición porque su stock
    actual es menor o igual al mínimo establecido.
</p>

<!-- RESUMEN -->

<div class="row mb-4">

    <div class="col-md-4 mb-3">
        <div class="card border-danger h-100">
            <div class="card-body">
                <h5 class="card-title">Sin stock</h5>

                <h2 class="text-danger">
                    @sinStock
                </h2>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card border-warning h-100">
            <div class="card-body">
                <h5 class="card-title">Stock bajo</h5>

                <h2 class="text-warning">
                    @stockBajo
                </h2>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">
                    Total para reponer
                </h5>

                <h2>@Model.Count</h2>
            </div>
        </div>
    </div>

</div>

<!-- TABLA -->
@if (!Model.Any())
{
    <div class="alert alert-success">
        No hay productos activos que necesiten reposición.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">

            <thead>
                <tr>
                    <th>Código</th>
                    <th>Producto</th>
                    <th>Categoría</th>
                    <th>Stock actual</th>
                    <th>Stock mínimo</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var producto in Model)
                {
                    <tr>

                        <td>
                            @producto.CodigoInterno
                        </td>

                        <td>
                            @producto.Nombre
                        </td>

                        <td>
                            @producto.Categoria
                        </td>

                        <td>
                            @producto.StockActual
                        </td>

                        <td>
                            @producto.StockMinimo
                        </td>

                        <td>

                            @if (producto.EstadoStock == "SinStock")
                            {
                                <span class="badge bg-danger">
                                    Sin stock
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    Stock bajo
                                </span>
                            }

                        </td>

                        <td>

                            <a asp-controller="Productos"
                               asp-action="IngresarStock"
                               asp-route-id="@producto.Id"
                               class="btn btn-sm btn-outline-primary">

                                Ingresar stock

                            </a>

                        </td>

                    </tr>
                }

            </tbody>
        </table>
    </div>
}

<a asp-controller="Productos"
   asp-action="Index"
   class="btn btn-secondary mt-3">

    Volver a productos

</a>
