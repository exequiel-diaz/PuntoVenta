@model SistemaVenta.Application.DTOs.Productos.ProductoDetalleDto
@using System.Text.Json

@{
    ViewData["Title"] = "Código de barras";

    var codigoJson = JsonSerializer.Serialize(Model.CodigoInterno);
}

<style>
    .etiqueta-producto {
        width: 340px;
        max-width: 100%;
        border: 1px solid #ccc;
        border-radius: 8px;
        padding: 18px;
        margin: 20px auto;
        text-align: center;
        background-color: white;
        color: black;
    }

        .etiqueta-producto .nombre {
            font-size: 16px;
            font-weight: bold;
            margin-bottom: 12px;
            overflow-wrap: anywhere;
        }

        .etiqueta-producto svg {
            max-width: 100%;
            height: auto;
        }

        .etiqueta-producto .precio {
            font-size: 22px;
            font-weight: bold;
            margin-top: 12px;
        }

    @@media print {
        @@page {
            margin: 8mm;
        }

        body {
            background: white !important;
        }

            body * {
                visibility: hidden !important;
            }

        #etiqueta,
        #etiqueta * {
            visibility: visible !important;
        }

        #etiqueta {
            position: absolute;
            left: 0;
            top: 0;
            margin: 0;
            border: none;
            width: 80mm;
            padding: 3mm;
        }
    }
</style>

<div class="container mt-4">

    <h2>Código de barras del producto</h2>

    <p class="text-muted">
        Podés imprimir esta etiqueta y colocarla
        en el producto.
    </p>

    <div id="etiqueta" class="etiqueta-producto">

        <div class="nombre">
            @Model.Nombre
        </div>

        <svg id="codigoBarras"></svg>

        <div class="precio">
            $ @Model.PrecioVenta.ToString("N2")
        </div>

    </div>

    <div id="errorCodigo"
         class="alert alert-danger d-none">
    </div>

    <div class="text-center mt-3">

        <button type="button"
                id="btnImprimir"
                class="btn btn-primary"
                disabled>
            Imprimir etiqueta
        </button>

        <a asp-controller="Productos"
           asp-action="Index"
           class="btn btn-secondary">
            Volver a productos
        </a>

    </div>

</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const codigo = @Html.Raw(codigoJson);

            const boton = document.getElementById("btnImprimir");
            const error = document.getElementById("errorCodigo");

            try {

                if (typeof JsBarcode === "undefined") {
                    throw new Error(
                        "No se pudo cargar la biblioteca de códigos de barras."
                    );
                }

                if (!codigo || !/^[\x20-\x7E]+$/.test(codigo)) {
                    throw new Error(
                        "El código interno contiene caracteres no compatibles con esta configuración de Code 128."
                    );
                }

                JsBarcode("#codigoBarras", codigo, {

                    format: "CODE128",

                    lineColor: "#000000",

                    width: 2,

                    height: 75,

                    displayValue: true,

                    fontSize: 15,

                    margin: 10

                });

                boton.disabled = false;

            } catch (ex) {

                error.textContent = ex.message;
                error.classList.remove("d-none");

            }

            boton.addEventListener("click", function () {
                window.print();
            });

        });
    </script>
}
