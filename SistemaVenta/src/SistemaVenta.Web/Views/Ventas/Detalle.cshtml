@model SistemaVenta.Application.DTOs.Ventas.VentaDetalleDto

@{
    ViewData["Title"] = $"Detalle de venta #{Model.Id}";

    var cultura = System.Globalization.CultureInfo
        .GetCultureInfo("es-AR");
}

@if (TempData["MensajeExito"] is string mensajeExito)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">
        @mensajeExito

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar">
        </button>
    </div>
}

@if (TempData["MensajeError"] is string mensajeError)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">
        @mensajeError

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar">
        </button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Detalle de venta #@Model.Id</h2>

    <a asp-controller="Ventas"
       asp-action="Index"
       class="btn btn-secondary">
        Volver al historial
    </a>
</div>

<!-- INFORMACIÓN GENERAL -->

<div class="card mb-4">

    <div class="card-header">
        <h5 class="mb-0">Información de la venta</h5>
    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-md-6 mb-3">
                <strong>Número de venta:</strong>
                #@Model.Id
            </div>

            <div class="col-md-6 mb-3">
                <strong>Fecha:</strong>
                @Model.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
            </div>

            <div class="col-md-6 mb-3">
                <strong>Cliente:</strong>
                @Model.NombreCliente
            </div>

            <div class="col-md-6 mb-3">
                <strong>Estado:</strong>

                @if (Model.Estado ==
                                SistemaVenta.Domain.Enums.EstadoVenta.Confirmada)
                {
                    <span class="badge bg-success">
                        Confirmada
                    </span>
                }
                else if (Model.Estado ==
                SistemaVenta.Domain.Enums.EstadoVenta.Anulada)
                {
                    <span class="badge bg-danger">
                        Anulada
                    </span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">
                        Pendiente
                    </span>
                }
            </div>

            <div class="col-md-6 mb-3">
                <strong>Facturación:</strong>

                @if (Model.TieneFactura)
                {
                    <span class="badge bg-success">
                        Factura emitida
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        Sin factura
                    </span>
                }
            </div>

        </div>

    </div>
</div>

<!-- PRODUCTOS VENDIDOS -->

<div class="card mb-4">

    <div class="card-header">
        <h5 class="mb-0">Productos vendidos</h5>
    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-striped table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Producto</th>
                        <th class="text-end">Cantidad</th>
                        <th class="text-end">Precio unitario</th>
                        <th class="text-end">Subtotal</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var detalle in Model.Detalles)
                    {
                        <tr>
                            <td>
                                @detalle.NombreProducto
                            </td>

                            <td class="text-end">
                                @detalle.Cantidad.ToString("0.###", cultura)
                            </td>

                            <td class="text-end">
                                @detalle.PrecioUnitario.ToString("C2", cultura)
                            </td>

                            <td class="text-end">
                                @detalle.Subtotal.ToString("C2", cultura)
                            </td>
                        </tr>
                    }

                </tbody>

                <tfoot>
                    <tr class="table-light">
                        <td colspan="3" class="text-end">
                            <strong>Total de la venta:</strong>
                        </td>

                        <td class="text-end">
                            <strong>
                                @Model.Total.ToString("C2", cultura)
                            </strong>
                        </td>
                    </tr>
                </tfoot>

            </table>

        </div>

    </div>
</div>

<!-- ACCIONES -->

<div class="mt-3 d-flex flex-wrap gap-2 align-items-center">

    <a asp-controller="Ventas"
       asp-action="Index"
       class="btn btn-secondary">
        Volver al historial
    </a>

    <a asp-controller="Ventas"
       asp-action="Crear"
       class="btn btn-primary">
        + Nueva venta
    </a>

    @if (Model.Estado ==
        SistemaVenta.Domain.Enums.EstadoVenta.Confirmada)
    {
        @if (!Model.TieneFactura)
        {
            <!-- EMITIR FACTURA -->

            <form asp-controller="Facturas"
                  asp-action="Emitir"
                  method="post"
                  class="d-flex gap-2 align-items-center">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="ventaId"
                       value="@Model.Id" />

                <select name="tipo"
                        class="form-select"
                        aria-label="Tipo de factura"
                        required>
                    <option value="1">Factura A</option>
                    <option value="2">Factura B</option>
                    <option value="3">Factura C</option>
                </select>

                <button type="submit"
                        class="btn btn-success text-nowrap"
                        onclick="return confirm('¿Querés emitir esta factura?');">
                    Emitir factura
                </button>

            </form>

            <!-- ANULAR VENTA -->

            <form asp-controller="Ventas"
                  asp-action="Anular"
                  asp-route-id="@Model.Id"
                  method="post"
                  class="ms-md-auto"
                  onsubmit="return confirm('¿Estás seguro de que querés anular esta venta? Se restaurará el stock de los productos vendidos.');">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-outline-danger">
                    Anular venta
                </button>

            </form>
        }

        else
        {
            <div class="w-100 mt-3">
                <h5>Documentos comerciales</h5>

                <form asp-controller="DocumentosComerciales"
                      asp-action="EmitirNotaCredito"
                      method="post"
                      class="card card-body mt-3">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="facturaId"
                           value="@Model.FacturaId" />

                    <h6>Emitir Nota de Crédito</h6>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Motivo</label>

                            <input type="text"
                                   name="motivo"
                                   class="form-control"
                                   maxlength="200"
                                   required />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Importe</label>

                            <input type="number"
                                   name="importeTotal"
                                   class="form-control"
                                   min="0.01"
                                   step="0.01"
                                   required />
                        </div>

                        <div class="col-md-3 d-flex align-items-end">
                            <button type="submit"
                                    class="btn btn-warning w-100"
                                    onclick="return confirm('¿Emitir esta Nota de Crédito?');">
                                Emitir Nota de Crédito
                            </button>
                        </div>
                    </div>

                </form>

                <!-- NOTA DE DÉBITO -->

                <form asp-controller="DocumentosComerciales"
                      asp-action="EmitirNotaDebito"
                      method="post"
                      class="card card-body mt-3">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="facturaId"
                           value="@Model.FacturaId" />

                    <h6>Emitir Nota de Débito</h6>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label">Motivo</label>

                            <input type="text"
                                   name="motivo"
                                   class="form-control"
                                   maxlength="200"
                                   required />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Importe</label>

                            <input type="number"
                                   name="importeTotal"
                                   class="form-control"
                                   min="0.01"
                                   step="0.01"
                                   required />
                        </div>

                        <div class="col-md-3 d-flex align-items-end">
                            <button type="submit"
                                    class="btn btn-primary w-100"
                                    onclick="return confirm('¿Emitir esta Nota de Débito?');">
                                Emitir Nota de Débito
                            </button>
                        </div>

                    </div>
                </form>


                @if (Model.NotasComerciales.Any())
                {
                    <div class="w-100 mt-4">
                        <h5>Notas comerciales emitidas</h5>

                        <table class="table table-striped table-bordered mt-3">
                            <thead>
                                <tr>
                                    <th>Documento</th>
                                    <th>Número</th>
                                    <th>Motivo</th>
                                    <th>Importe</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var nota in Model.NotasComerciales)
                                {
                                    <tr>
                                        <td>@nota.Tipo</td>
                                        <td>@nota.Numero</td>
                                        <td>@nota.Motivo</td>
                                        <td>@nota.Importe.ToString("C2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }


            </div>
        }
    }
</div>

