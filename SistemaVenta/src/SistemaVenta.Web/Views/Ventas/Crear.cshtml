@model SistemaVenta.Web.ViewModels.Ventas.RegistrarVentaViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Registrar venta";

    var preciosJson = JsonSerializer.Serialize(Model.PreciosProductos);

    var productosJson = JsonSerializer.Serialize(
        Model.ProductosDisponibles.Select(p => new
        {
            id = p.Value,
            texto = p.Text
        })
    );

    var clientesJson = JsonSerializer.Serialize(
        Model.ClientesDisponibles.Select(c => new
        {
            id = c.Value,
            texto = c.Text
        })
    );
}

<h2 class="mb-4">Registrar venta</h2>

@if (TempData["MensajeExito"] is string mensaje)
{
    <div class="alert alert-success">
        @mensaje
    </div>
}

<form id="formulario-venta"
      asp-controller="Ventas"
      asp-action="Crear"
      method="post">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"></div>

    <!-- BUSCADOR DE CLIENTES -->

    <div class="mb-4">
        <label for="buscar-cliente" class="form-label">
            Cliente
        </label>

        <div class="position-relative buscador"
             data-tipo="cliente">

            <input type="search"
                   id="buscar-cliente"
                   class="form-control campo-busqueda"
                   placeholder="Buscar por nombre, razón social o documento..."
                   autocomplete="off"
                   role="combobox"
                   aria-autocomplete="list"
                   aria-expanded="false"
                   aria-controls="opciones-cliente" />

            <input asp-for="ClienteId"
                   type="hidden"
                   class="valor-seleccionado" />

            <div id="opciones-cliente"
                 class="list-group position-absolute w-100 shadow-sm opciones"
                 role="listbox"
                 style="display:none; z-index:1050; max-height:250px; overflow-y:auto;">
            </div>
        </div>

        <span asp-validation-for="ClienteId"
              class="text-danger"></span>

        <small class="form-text text-muted">
            Para ventas al contado podés seleccionar
            Consumidor final sin registrar un cliente.
        </small>
    </div>

    <!-- MODALIDAD DE VENTA -->

    <div class="mb-4">
        <label asp-for="Modalidad" class="form-label">
            Modalidad de venta
        </label>

        <select asp-for="Modalidad"
                class="form-select">

            <option value="1">Contado</option>
            <option value="2">Cuenta corriente</option>

        </select>

        <span asp-validation-for="Modalidad"
              class="text-danger"></span>

        <small class="form-text text-muted">
            Para vender a cuenta corriente, el cliente
            debe tener una cuenta activa y crédito disponible.
        </small>
    </div>

    <hr />

    <!-- DETALLE DE PRODUCTOS -->

    <h4 class="mb-3">Detalle de productos</h4>

    <div id="contenedor-detalles">

        @for (var i = 0; i < Model.Detalles.Count; i++)
        {
            <div class="row mb-3 detalle-venta">

                <!-- BUSCADOR DE PRODUCTOS -->

                <div class="col-md-4">

                    <label class="form-label"
                           for="buscar-producto-@i">
                        Producto
                    </label>

                    <div class="position-relative buscador"
                         data-tipo="producto">

                        <input type="search"
                               id="buscar-producto-@i"
                               class="form-control campo-busqueda"
                               placeholder="Buscar producto por nombre..."
                               autocomplete="off"
                               role="combobox"
                               aria-autocomplete="list"
                               aria-expanded="false"
                               aria-controls="opciones-producto-@i" />

                        <input asp-for="Detalles[i].ProductoId"
                               type="hidden"
                               class="valor-seleccionado" />

                        <div id="opciones-producto-@i"
                             class="list-group position-absolute w-100 shadow-sm opciones"
                             role="listbox"
                             style="display:none; z-index:1050; max-height:250px; overflow-y:auto;">
                        </div>

                    </div>

                    <span asp-validation-for="Detalles[i].ProductoId"
                          class="text-danger"></span>
                </div>

                <!-- CANTIDAD -->

                <div class="col-md-2">

                    <label class="form-label">
                        Cantidad
                    </label>

                    <input asp-for="Detalles[i].Cantidad"
                           type="number"
                           min="1"
                           step="1"
                           class="form-control cantidad" />

                    <span asp-validation-for="Detalles[i].Cantidad"
                          class="text-danger"></span>
                </div>

                <!-- PRECIO UNITARIO -->

                <div class="col-md-2">

                    <label class="form-label">
                        Precio unitario
                    </label>

                    <input type="text"
                           class="form-control precio-unitario"
                           readonly />
                </div>

                <!-- SUBTOTAL -->

                <div class="col-md-2">

                    <label class="form-label">
                        Subtotal
                    </label>

                    <input type="text"
                           class="form-control subtotal"
                           readonly />
                </div>

                <!-- QUITAR -->

                <div class="col-md-2 d-flex align-items-end">

                    <button type="button"
                            class="btn btn-outline-danger w-100"
                            onclick="eliminarDetalle(this)">
                        Quitar
                    </button>

                </div>

            </div>
        }

    </div>

    <!-- AGREGAR PRODUCTO -->

    <button type="button"
            class="btn btn-outline-primary mb-4"
            onclick="agregarDetalle()">

        + Agregar producto

    </button>

    <hr />

    <!-- TOTAL ESTIMADO -->

    <div class="d-flex justify-content-end mb-4">

        <div class="text-end">

            <h5>Total estimado</h5>

            <h3 id="total-venta">
                $0,00
            </h3>

            <small class="text-muted">
                El importe definitivo se calcula
                al confirmar la venta.
            </small>

        </div>

    </div>

    <!-- BOTONES -->

    <div class="mb-3">

        <button type="submit"
                class="btn btn-success">
            Confirmar venta
        </button>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>

    </div>

</form>

<!-- PLANTILLA PARA NUEVOS PRODUCTOS -->

<template id="plantilla-detalle">

    <div class="row mb-3 detalle-venta">

        <div class="col-md-4">

            <label class="form-label">
                Producto
            </label>

            <div class="position-relative buscador"
                 data-tipo="producto">

                <input type="search"
                       class="form-control campo-busqueda"
                       placeholder="Buscar producto por nombre..."
                       autocomplete="off"
                       role="combobox"
                       aria-autocomplete="list"
                       aria-expanded="false" />

                <input type="hidden"
                       name="Detalles[__index__].ProductoId"
                       value="0"
                       class="valor-seleccionado" />

                <div class="list-group position-absolute w-100 shadow-sm opciones"
                     role="listbox"
                     style="display:none; z-index:1050; max-height:250px; overflow-y:auto;">
                </div>

            </div>

        </div>

        <div class="col-md-2">

            <label class="form-label">
                Cantidad
            </label>

            <input type="number"
                   name="Detalles[__index__].Cantidad"
                   value="1"
                   min="1"
                   step="1"
                   class="form-control cantidad" />

        </div>

        <div class="col-md-2">

            <label class="form-label">
                Precio unitario
            </label>

            <input type="text"
                   class="form-control precio-unitario"
                   readonly />

        </div>

        <div class="col-md-2">

            <label class="form-label">
                Subtotal
            </label>

            <input type="text"
                   class="form-control subtotal"
                   readonly />

        </div>

        <div class="col-md-2 d-flex align-items-end">

            <button type="button"
                    class="btn btn-outline-danger w-100"
                    onclick="eliminarDetalle(this)">
                Quitar
            </button>

        </div>

    </div>

</template>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        // DATOS RECIBIDOS DESDE EL CONTROLADOR

        const preciosProductos = @Html.Raw(preciosJson);
        const productos = @Html.Raw(productosJson);
        const clientes = @Html.Raw(clientesJson);

        const formatoMoneda = new Intl.NumberFormat("es-AR", {
            style: "currency",
            currency: "ARS"
        });

        // NORMALIZAR TEXTO PARA BUSCAR SIN IMPORTAR TILDES

        function normalizar(texto) {

            return String(texto ?? "")
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "")
                .toLocaleLowerCase("es-AR")
                .trim();
        }

        // CALCULAR PRECIOS, SUBTOTALES Y TOTAL

        function calcularTotales() {

            let total = 0;

            const filas = document.querySelectorAll(
                "#contenedor-detalles .detalle-venta"
            );

            filas.forEach(fila => {

                const campoProducto = fila.querySelector(
                    'input[name$=".ProductoId"]'
                );

                const campoCantidad = fila.querySelector(
                    'input[name$=".Cantidad"]'
                );

                const campoPrecio = fila.querySelector(
                    ".precio-unitario"
                );

                const campoSubtotal = fila.querySelector(
                    ".subtotal"
                );

                const productoId = campoProducto.value;

                const precio = Number(
                    preciosProductos[productoId] ?? 0
                );

                const cantidad = Number(
                    campoCantidad.value.replace(",", ".")
                );

                const subtotal =
                    Number.isFinite(cantidad) && cantidad > 0
                        ? precio * cantidad
                        : 0;

                campoPrecio.value =
                    formatoMoneda.format(precio);

                campoSubtotal.value =
                    formatoMoneda.format(subtotal);

                total += subtotal;
            });

            document.getElementById("total-venta").textContent =
                formatoMoneda.format(total);
        }

        // CERRAR SUGERENCIAS

        function cerrarOpciones(buscador) {

            const lista = buscador.querySelector(".opciones");
            const entrada = buscador.querySelector(".campo-busqueda");

            lista.style.display = "none";
            entrada.setAttribute("aria-expanded", "false");
        }

        // INICIALIZAR BUSCADOR DE CLIENTES O PRODUCTOS

        function inicializarBuscador(buscador) {

            const entrada = buscador.querySelector(".campo-busqueda");
            const oculto = buscador.querySelector(".valor-seleccionado");
            const lista = buscador.querySelector(".opciones");

            const esCliente = buscador.dataset.tipo === "cliente";

            const datos = esCliente ? clientes : productos;

            let resultados = [];
            let indiceActivo = -1;

            function seleccionar(opcion) {

                oculto.value = opcion.id;
                entrada.value = opcion.texto;

                cerrarOpciones(buscador);
                calcularTotales();
            }

            function mostrarOpciones() {

                const texto = normalizar(entrada.value);

                resultados = datos
                    .filter(item =>
                        normalizar(item.texto).includes(texto)
                    )
                    .slice(0, 12);

                lista.replaceChildren();

                indiceActivo = -1;

                if (resultados.length === 0) {

                    const mensaje = document.createElement("div");

                    mensaje.className =
                        "list-group-item text-muted";

                    mensaje.textContent =
                        "No se encontraron coincidencias.";

                    lista.appendChild(mensaje);

                } else {

                    resultados.forEach((item, indice) => {

                        const boton = document.createElement("button");

                        boton.type = "button";

                        boton.className =
                            "list-group-item list-group-item-action text-start";

                        boton.setAttribute("role", "option");

                        boton.textContent = item.texto;

                        boton.addEventListener("mousedown", evento => {
                            evento.preventDefault();
                        });

                        boton.addEventListener("click", () => {
                            seleccionar(item);
                        });

                        lista.appendChild(boton);
                    });
                }

                lista.style.display = "block";
                entrada.setAttribute("aria-expanded", "true");
            }

            function actualizarResaltado() {

                const botones = lista.querySelectorAll(
                    'button[role="option"]'
                );

                botones.forEach((boton, indice) => {

                    const activo = indice === indiceActivo;

                    boton.classList.toggle("active", activo);

                    boton.setAttribute(
                        "aria-selected",
                        String(activo)
                    );

                    if (activo) {
                        boton.scrollIntoView({
                            block: "nearest"
                        });
                    }
                });
            }

            // RECUPERAR VALOR SI EL SERVIDOR DEVUELVE EL FORMULARIO

            const seleccionActual = datos.find(
                item => String(item.id) === String(oculto.value)
            );

            if (seleccionActual) {

                entrada.value = seleccionActual.texto;

            } else if (esCliente) {

                const consumidorFinal = datos.find(
                    item => item.id === ""
                );

                if (consumidorFinal) {
                    entrada.value = consumidorFinal.texto;
                }
            }

            // FILTRAR MIENTRAS SE ESCRIBE

            entrada.addEventListener("input", () => {

                oculto.value = esCliente ? "" : "0";

                calcularTotales();
                mostrarOpciones();
            });

            entrada.addEventListener("focus", mostrarOpciones);

            // NAVEGACIÓN CON TECLADO

            entrada.addEventListener("keydown", evento => {

                if (evento.key === "Escape") {

                    cerrarOpciones(buscador);
                    return;
                }

                if (evento.key === "ArrowDown" ||
                    evento.key === "ArrowUp") {

                    evento.preventDefault();

                    if (lista.style.display === "none") {
                        mostrarOpciones();
                    }

                    if (resultados.length === 0) {
                        return;
                    }

                    if (evento.key === "ArrowDown") {

                        indiceActivo =
                            (indiceActivo + 1) % resultados.length;

                    } else {

                        indiceActivo =
                            (indiceActivo - 1 + resultados.length)
                            % resultados.length;
                    }

                    actualizarResaltado();
                }

                if (evento.key === "Enter" &&
                    lista.style.display !== "none" &&
                    indiceActivo >= 0) {

                    evento.preventDefault();

                    seleccionar(resultados[indiceActivo]);
                }
            });

            // NO CONSERVAR UN ID SI SE ESCRIBIÓ SIN SELECCIONAR

            entrada.addEventListener("blur", () => {

                const seleccion = datos.find(
                    item => String(item.id) === String(oculto.value)
                );

                if (!seleccion) {

                    if (esCliente) {

                        const consumidorFinal = datos.find(
                            item => item.id === ""
                        );

                        entrada.value =
                            consumidorFinal?.texto ?? "";

                    } else {

                        entrada.value = "";
                    }
                }

                cerrarOpciones(buscador);
            });
        }

        // REINDEXAR LOS PRODUCTOS DEL FORMULARIO

        function reindexarDetalles() {

            const filas = document.querySelectorAll(
                "#contenedor-detalles .detalle-venta"
            );

            filas.forEach((fila, indice) => {

                fila.querySelectorAll("[name]").forEach(campo => {

                    campo.name = campo.name.replace(
                        /Detalles\[\d+\]/g,
                        `Detalles[${indice}]`
                    );
                });

                fila.querySelectorAll("[id]").forEach(campo => {

                    campo.id = campo.id
                        .replace(
                            /Detalles_\d+__/g,
                            `Detalles_${indice}__`
                        )
                        .replace(
                            /buscar-producto-\d+/g,
                            `buscar-producto-${indice}`
                        )
                        .replace(
                            /opciones-producto-\d+/g,
                            `opciones-producto-${indice}`
                        );
                });

                fila.querySelectorAll("label[for]").forEach(label => {

                    label.htmlFor = label.htmlFor
                        .replace(
                            /Detalles_\d+__/g,
                            `Detalles_${indice}__`
                        )
                        .replace(
                            /buscar-producto-\d+/g,
                            `buscar-producto-${indice}`
                        );
                });

                fila.querySelectorAll("[aria-controls]").forEach(campo => {

                    campo.setAttribute(
                        "aria-controls",
                        campo.getAttribute("aria-controls")
                            .replace(
                                /opciones-producto-\d+/g,
                                `opciones-producto-${indice}`
                            )
                    );
                });

                fila.querySelectorAll("[data-valmsg-for]").forEach(elemento => {

                    const nombre = elemento.getAttribute(
                        "data-valmsg-for"
                    );

                    elemento.setAttribute(
                        "data-valmsg-for",
                        nombre.replace(
                            /Detalles\[\d+\]/g,
                            `Detalles[${indice}]`
                        )
                    );
                });
            });
        }

        // AGREGAR PRODUCTO

        function agregarDetalle() {

            const contenedor = document.getElementById(
                "contenedor-detalles"
            );

            const plantilla = document.getElementById(
                "plantilla-detalle"
            );

            const indice = contenedor.querySelectorAll(
                ".detalle-venta"
            ).length;

            const html = plantilla.innerHTML.replaceAll(
                "__index__",
                indice
            );

            contenedor.insertAdjacentHTML(
                "beforeend",
                html
            );

            const nuevaFila = contenedor.lastElementChild;

            inicializarBuscador(
                nuevaFila.querySelector(".buscador")
            );

            reindexarDetalles();
            calcularTotales();

            nuevaFila.querySelector(".campo-busqueda").focus();
        }

        // ELIMINAR PRODUCTO

        function eliminarDetalle(boton) {

            const filas = document.querySelectorAll(
                "#contenedor-detalles .detalle-venta"
            );

            if (filas.length <= 1) {

                alert(
                    "La venta debe tener al menos un producto."
                );

                return;
            }

            boton.closest(".detalle-venta").remove();

            reindexarDetalles();
            calcularTotales();
        }

        // VALIDAR PRODUCTOS REPETIDOS Y NO SELECCIONADOS

        function validarProductos() {

            const seleccionados = new Set();

            const campos = document.querySelectorAll(
                '#contenedor-detalles input[name$=".ProductoId"]'
            );

            for (const campo of campos) {

                const id = campo.value;

                if (!id || id === "0") {

                    return "Seleccioná un producto en cada fila.";
                }

                if (seleccionados.has(id)) {

                    return "No podés seleccionar el mismo producto " +
                           "más de una vez en la venta.";
                }

                seleccionados.add(id);
            }

            return null;
        }

        // INICIALIZAR BUSCADORES

        document.querySelectorAll(".buscador").forEach(
            inicializarBuscador
        );

        // ACTUALIZAR TOTAL CUANDO CAMBIA UNA CANTIDAD

        document.getElementById("contenedor-detalles")
            .addEventListener("input", calcularTotales);

        // CERRAR LISTAS AL HACER CLIC FUERA

        document.addEventListener("pointerdown", evento => {

            document.querySelectorAll(".buscador").forEach(
                buscador => {

                    if (!buscador.contains(evento.target)) {
                        cerrarOpciones(buscador);
                    }
                }
            );
        });

        // VALIDACIONES ANTES DE ENVIAR

        document.getElementById("formulario-venta")
            .addEventListener("submit", evento => {

                const error = validarProductos();

                if (error) {

                    evento.preventDefault();
                    alert(error);
                    return;
                }

                const cliente = document.querySelector(
                    '#formulario-venta input[name="ClienteId"]'
                );

                const modalidad = document.querySelector(
                    '#formulario-venta select[name="Modalidad"]'
                );

                if (modalidad.value === "2" && !cliente.value) {

                    evento.preventDefault();

                    alert(
                        "Para una venta a cuenta corriente " +
                        "seleccioná un cliente registrado."
                    );
                }
            });

        // CÁLCULO INICIAL

        calcularTotales();

    </script>
}
