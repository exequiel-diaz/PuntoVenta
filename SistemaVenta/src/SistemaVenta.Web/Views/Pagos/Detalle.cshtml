@model SistemaVenta.Application.DTOs.Pagos.PagoDetalleDto

@{
    ViewData["Title"] = "Recibo de pago";
}

<style>
    .recibo {
        max-width: 800px;
        margin: 0 auto;
    }

    @@media print {
        .no-imprimir,
        header,
        footer,
        nav {
            display: none !important;
        }

        .recibo {
            max-width: 100%;
        }

        body {
            background: white !important;
        }
    }
</style>

<div class="recibo">

    <div class="d-flex justify-content-end mb-4 no-imprimir">
        <button type="button"
                class="btn btn-primary"
                onclick="window.print()">
            Imprimir recibo
        </button>
    </div>

    <div class="card p-4">

        <div class="d-flex justify-content-between border-bottom pb-3 mb-4">
            <div>
                <h2>SistemaVenta</h2>
                <p class="mb-0">Comprobante interno de pago</p>
                <small>Sin validez fiscal</small>
            </div>

            <div class="text-end">
                <h3>RECIBO</h3>
                <p class="mb-1">
                    <strong>Número:</strong> #@Model.Id
                </p>
                <p class="mb-0">
                    <strong>Fecha:</strong>
                    @Model.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                </p>
            </div>
        </div>

        <div class="mb-4">
            <p class="mb-1">
                <strong>Forma de pago:</strong> @Model.FormaPago
            </p>

            <p class="mb-0">
                <strong>Estado:</strong> @Model.Estado
            </p>
        </div>

        <div class="bg-light border rounded p-3 text-center mb-4">
            <p class="mb-1 text-muted">Importe recibido</p>
            <h2>@Model.Importe.ToString("C2")</h2>
        </div>

        @if (Model.Aplicaciones.Any())
        {
            <h5>Detalle de aplicaciones</h5>

            <table class="table table-bordered mt-3">
                <thead>
                    <tr>
                        <th>Tipo</th>
                        <th>Referencia</th>
                        <th>Importe aplicado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var aplicacion in Model.Aplicaciones)
                    {
                        <tr>
                            <td>@aplicacion.Tipo</td>
                            <td>#@aplicacion.ReferenciaId</td>
                            <td>
                                @aplicacion.ImporteAplicado.ToString("C2")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
        {
            <div class="mt-3">
                <strong>Observaciones:</strong>
                <p>@Model.Observaciones</p>
            </div>
        }

        <hr />

        <p class="text-center text-muted small mb-0">
            Recibo interno de SistemaVenta.
            No constituye un comprobante fiscal válido.
        </p>

    </div>
</div>
