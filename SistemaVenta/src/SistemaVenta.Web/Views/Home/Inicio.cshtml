@{
    ViewData["Title"] = "Inicio";
}

<style>
    .hero-section {
        background-color: #ffffff;
        min-height: 100vh;
        display: flex;
        align-items: center;
    }
    
    .font-serif {
        font-family: Georgia, 'Times New Roman', Times, serif;
        color: #0b1527; /* Azul muy oscuro, casi negro */
        letter-spacing: -0.02em;
    }

    .text-muted-custom {
        color: #5c687d;
        font-size: 1.1rem;
        line-height: 1.6;
    }

    .btn-primary-custom {
        background-color: #0047ff;
        border-color: #0047ff;
        font-weight: 500;
        padding: 0.6rem 1.5rem;
        border-radius: 50rem; 

    .btn-primary-custom:hover {
        background-color: #0036c7;
        border-color: #0036c7;
    }

    .btn-outline-custom {
        border: 1px solid #d1d5db;
        color: #0b1527;
        font-weight: 500;
        padding: 0.6rem 1.5rem;
        border-radius: 50rem;
    }

    .btn-outline-custom:hover {
        background-color: #f3f4f6;
    }

    .placeholder-img {
        background-color: #f8f9fa;
        border: 2px dashed #dee2e6;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        min-height: 400px;
        color: #adb5bd;
    }
</style>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-light bg-white py-3 border-bottom">
    <div class="container">
        <!-- Logo -->
        <a class="navbar-brand d-flex align-items-center fw-bold fs-4" href="#">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="#0047ff" class="me-2" viewBox="0 0 16 16">
                <path d="M11.251.068a2 2 0 0 1 1.997 1.727l.375 3.875a2 2 0 0 1-1.517 1.914l-4.882 1.05a2 2 0 0 1-2.378-1.492L4.369 3.36a2 2 0 0 1 1.517-1.914L10.768.396a2 2 0 0 1 1.891-.328zM6.25 2.068a1 1 0 0 0-.758.957l.477 3.781a1 1 0 0 0 1.189.746l4.882-1.05a1 1 0 0 0 .758-.957l-.375-3.875a1 1 0 0 0-.998-.864L11.25.068zM1 3a1 1 0 0 1 1-1h3a1 1 0 0 1 0 2H2v10h10v-2a1 1 0 1 1 2 0v3a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V3z"/>
            </svg>
            Nombre del Sistema
        </a>

        <!-- Botón Mobile -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Links -->
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav mx-auto mb-2 mb-lg-0 fw-medium">
                <li class="nav-item"><a class="nav-link text-dark" href="#">Características</a></li>
                <li class="nav-item"><a class="nav-link text-dark" href="#">Precios</a></li>
                <li class="nav-item"><a class="nav-link text-dark" href="#">Recursos</a></li>
                <li class="nav-item"><a class="nav-link text-dark" href="#">Compañía</a></li>
            </ul>
            <div class="d-flex">
                <a asp-controller = "Cuenta" asp-action = "Login" class="btn btn-dark rounded-pill px-4">Iniciar Sesión</a>
            </div>
        </div>
    </div>
</nav>

<!-- Hero Section -->
<section class="hero-section py-5">
    <div class="container">
        <div class="row align-items-center g-5">
            
            <!-- Columna Izquierda (Texto) -->
            <div class="col-lg-6">
                <h1 class="font-serif display-3 fw-bold mb-4" style="line-height: 1.1;">
                    Toma el control de tu negocio. Escala tus operaciones.
                </h1>
                <p class="text-muted-custom mb-5 pe-lg-5">
                    La plataforma todo en uno para gestionar, analizar y hacer crecer tu empresa sin complicaciones.
                </p>
                
                <div class="d-flex flex-column flex-sm-row gap-3 mb-5">
                    <a href="#" class="btn btn-primary-custom text-white d-flex align-items-center justify-content-center">
                        Iniciar Sesión 
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="ms-2" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z"/>
                        </svg>
                    </a>
                    <a href="#" class="btn btn-outline-custom d-flex align-items-center justify-content-center">
                        Saber más
                    </a>
                </div>

                <!-- Prueba Social (Logos) -->
                <div class="mt-5">
                    <p class="text-muted small fw-medium mb-3">Con la confianza de más de 10,000 empresas</p>
                    <div class="d-flex align-items-center gap-4 text-muted opacity-75">
                        <!-- Simulación de logos con texto -->
                        <span class="fw-bold fs-5"><i class="bi bi-chevron-double-left"></i> Vanguard</span>
                        <span class="fw-bold fs-5"><i class="bi bi-grid-3x3-gap-fill"></i> BizSync</span>
                        <span class="fw-bold fs-5"><i class="bi bi-triangle-fill"></i> Nova</span>
                    </div>
                </div>
            </div>

            <!-- Columna Derecha (Imagen / Molde) -->
            <div class="col-lg-6">
                <!-- Aquí va tu imagen del dashboard en 3D -->
                <div class="placeholder-img shadow-sm">
                    <div class="text-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="mb-3" viewBox="0 0 16 16">
                            <path d="M6.002 5.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/>
                            <path d="M2.002 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2h-12zm12 1a1 1 0 0 1 1 1v6.5l-3.777-1.947a.5.5 0 0 0-.577.093l-3.71 3.71-2.66-1.772a.5.5 0 0 0-.63.062L1.002 12V3a1 1 0 0 1 1-1h12z"/>
                        </svg>
                        <p class="mb-0 fw-medium">Espacio para la imagen del Dashboard</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>