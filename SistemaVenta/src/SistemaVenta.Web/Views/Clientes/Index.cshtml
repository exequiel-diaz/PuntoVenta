@model IReadOnlyList<SistemaVenta.Application.DTOs.Clientes.ClienteListadoDto>
@using SistemaVenta.Domain.Enums

@{
    ViewData["Title"] = "Clientes";
}

<h2>Clientes</h2>

@if (TempData["MensajeExito"] is string mensaje)
{
    <div class="alert alert-success">
        @mensaje
    </div>
}

@if (TempData["MensajeError"] is string error)
{
    <div class="alert alert-danger">
        @error
    </div>
}

<p>Administración de clientes del sistema de ventas.</p>

<a asp-controller="Clientes"
   asp-action="CrearFisico"
   class="btn btn-primary mb-3">
    Nuevo cliente físico
</a>

<a asp-controller="Clientes"
   asp-action="CrearEmpresa"
   class="btn btn-outline-primary mb-3">
    Nuevo cliente empresa
</a>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Nombre / Razón social</th>
            <th>Tipo</th>
            <th>Documento</th>
            <th>Email</th>
            <th>Teléfono</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var cliente in Model)
        {
            <tr>
                <td>@cliente.Nombre</td>
                <td>@cliente.Tipo</td>
                <td>@cliente.Documento</td>
                <td>@cliente.Email</td>
                <td>@cliente.Telefono</td>
                <td>
                    @if (cliente.Estado == EstadoCliente.Activo)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </td>
                <td>

                    @if (cliente.Tipo == "Físico")
                    {
                        <a asp-controller="Clientes"
                           asp-action="EditarFisico"
                           asp-route-id="@cliente.Id"
                           class="btn btn-sm btn-outline-primary me-1">
                            Editar
                        </a>
                    }
                    else if (cliente.Tipo == "Empresa")
                    {
                        <a asp-controller="Clientes"
                           asp-action="EditarEmpresa"
                           asp-route-id="@cliente.Id"
                           class="btn btn-sm btn-outline-primary me-1">
                            Editar
                        </a>
                    }


                    @if (cliente.Estado == EstadoCliente.Activo)
                    {
                        <form asp-controller="Clientes"
                              asp-action="Desactivar"
                              asp-route-id="@cliente.Id"
                              method="post"
                              class="d-inline">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('¿Desactivar este cliente?');">
                                Desactivar
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="Clientes"
                              asp-action="Activar"
                              asp-route-id="@cliente.Id"
                              method="post"
                              class="d-inline">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-sm btn-outline-success">
                                Activar
                            </button>
                        </form>
                    }

                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p>No hay clientes registrados.</p>
}
