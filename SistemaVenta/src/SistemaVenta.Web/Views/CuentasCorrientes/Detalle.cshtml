@model SistemaVenta.Application.DTOs.CuentasCorrientes.CuentaCorrienteDetalleDto
@using SistemaVenta.Application.DTOs.CuentasCorrientes

@{
    ViewData["Title"] = "Detalle de Cuenta Corriente";

    var cultura = System.Globalization.CultureInfo.GetCultureInfo("es-AR");

    var zonaArgentina = TimeZoneInfo.FindSystemTimeZoneById(
        "America/Argentina/Buenos_Aires");

    var ventasPendientes =
        ViewData["VentasPendientes"]
            as IReadOnlyList<VentaPendienteCuentaCorrienteDto>
        ?? Array.Empty<VentaPendienteCuentaCorrienteDto>();
}

<div class="container-fluid mt-4">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Cuenta Corriente</h2>
            <h5>@Model.Cliente</h5>
            <span class="text-muted">
                Documento: @Model.Documento
            </span>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Volver
        </a>
    </div>

    <!-- RESUMEN DE LA CUENTA -->
    <div class="row mb-4">

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>Saldo actual</h6>
                    <h3 class="@(Model.SaldoActual > 0 ? "text-danger" : "text-success")">
                        @Model.SaldoActual.ToString("C", cultura)
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>Límite de deuda</h6>
                    <h3>
                        @Model.LimiteDeuda.ToString("C", cultura)
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>Crédito disponible</h6>
                    <h3>
                        @Model.CreditoDisponible.ToString("C", cultura)
                    </h3>
                </div>
            </div>
        </div>

    </div>

    <!-- HISTORIAL DE MOVIMIENTOS -->
    <div class="card shadow-sm mb-4">

        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Historial de movimientos</strong>

            <span class="badge bg-secondary">
                @Model.Estado
            </span>
        </div>

        <div class="card-body">

            @if (Model.Movimientos.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Fecha</th>
                                <th>Concepto</th>
                                <th>Origen</th>
                                <th>Debe</th>
                                <th>Haber</th>
                                <th>Saldo</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var movimiento in Model.Movimientos)
                            {
                                var fechaLocal = TimeZoneInfo.ConvertTimeFromUtc(
                                DateTime.SpecifyKind(
                                movimiento.Fecha,
                                DateTimeKind.Utc),
                                zonaArgentina);

                                <tr>
                                    <td>
                                        @fechaLocal.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>@movimiento.Descripcion</td>

                                    <td>@movimiento.Origen</td>

                                    <td class="text-danger">
                                        @(movimiento.Debe > 0
                                                                        ? movimiento.Debe.ToString("C", cultura)
                                                                        : "-")
                                                                          </td>

                                    <td class="text-success">
                                        @(movimiento.Haber > 0
                                                                        ? movimiento.Haber.ToString("C", cultura)
                                                                        : "-")
                            </td>

                                    <td>
                                        <strong>
                                            @movimiento.SaldoAcumulado.ToString("C", cultura)
                                        </strong>
                                    </td>
                                </tr>
                                                }
                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    Esta cuenta corriente todavía no tiene movimientos.
                </div>
            }

        </div>
    </div>

    <!-- VENTAS PENDIENTES DE COBRO -->
    <div class="card shadow-sm mb-4">

        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Ventas pendientes de cobro</strong>

            <span class="badge bg-warning text-dark">
                @ventasPendientes.Count pendiente(s)
            </span>
        </div>

        <div class="card-body">

            @if (ventasPendientes.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Venta</th>
                                <th class="text-end">Saldo pendiente</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var venta in ventasPendientes)
                            {
                                <tr>
                                    <td>
                                        <strong>
                                            Venta #@venta.VentaId
                                        </strong>
                                    </td>

                                    <td class="text-end text-danger">
                                        @venta.SaldoPendiente.ToString("C", cultura)
                                    </td>

                                    <td class="text-end">
                                        <a asp-controller="Pagos"
                                           asp-action="RegistrarCobroVenta"
                                           asp-route-ventaId="@venta.VentaId"
                                           class="btn btn-sm btn-success">
                                            Cobrar
                                        </a>
                                    </td>
                                </tr>
                            }
                    </tbody>

                </table>
            </div>

            <div class="text-end mt-3">
                <span class="text-muted">
                    Total pendiente de ventas:
                </span>

                <strong class="text-danger ms-2">
                    @(ventasPendientes.Sum(v => v.SaldoPendiente)
                                        .ToString("C", cultura))
                </strong>
            </div>
                        }
            else
            {
                <div class="alert alert-success mb-0">
                    No hay ventas con cobros pendientes.
                </div>
            }

        </div>
    </div>

</div>
