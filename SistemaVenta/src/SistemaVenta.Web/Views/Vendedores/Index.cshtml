@model List<SistemaVenta.Application.DTOs.Vendedores.VendedorDto>

@{
    ViewData["Title"] = "Gestión de vendedores";
}

<div class="container mt-4">

    @if (TempData["MensajeExito"] is string mensajeExito)
    {
        <div class="alert alert-success" role="alert">
            @mensajeExito
        </div>
    }

    @if (TempData["MensajeError"] is string mensajeError)
    {
        <div class="alert alert-danger" role="alert">
            @mensajeError
        </div>
    }



    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Gestión de vendedores</h2>
            <p class="text-muted mb-0">
                Administración de vendedores del sistema.
            </p>
        </div>

        <a asp-controller="Vendedores"
           asp-action="Crear"
           class="btn btn-primary">
            + Nuevo vendedor
        </a>
    </div>


    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">Vendedores registrados</h5>
        </div>

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="alert alert-info mb-0">
                    Todavía no hay vendedores registrados.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nombre completo</th>
                                <th>Usuario</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var vendedor in Model)
                            {
                                <tr>
                                    <td>@vendedor.Id</td>
                                    <td>@vendedor.NombreCompleto</td>
                                    <td>@vendedor.NombreUsuario</td>
                                    <td>
                                        @if (vendedor.Activo)
                                        {
                                            <span class="badge bg-success">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactivo
                                            </span>
                                        }
                                    </td>


                                    <td>
                                        <div class="d-flex gap-2">

                                            <a asp-controller="Vendedores"
                                               asp-action="Editar"
                                               asp-route-id="@vendedor.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Editar
                                            </a>

                                            <form asp-controller="Vendedores"
                                                  asp-action="CambiarEstado"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@vendedor.Id" />

                                                <input type="hidden"
                                                       name="activar"
                                                       value="@(vendedor.Activo ? "false" : "true")" />

                                                @if (vendedor.Activo)
                                                {
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-warning">
                                                        Desactivar
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success">
                                                        Activar
                                                    </button>
                                                }

                                            </form>


                                            <form asp-controller="Vendedores"
                                                  asp-action="Eliminar"
                                                  method="post"
                                                  onsubmit="return confirm('¿Estás seguro de que querés eliminar este vendedor? Esta acción no se puede deshacer.');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@vendedor.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    Eliminar
                                                </button>

                                            </form>

                                        </div>
                                    </td>


                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>

</div>
