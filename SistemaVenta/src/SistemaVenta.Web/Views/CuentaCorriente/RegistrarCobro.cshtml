@model SistemaVenta.Web.ViewModels.CuentasCorrientes.RegistrarMovimientoCuentaViewModel

@{
    ViewData["Title"] = "Registrar cobro";
}

<div class="container py-4">

    <h2>Registrar cobro</h2>

    <p class="text-muted">
        Cuenta corriente del cliente #@Model.ClienteId
    </p>

    <div class="card shadow-sm">
        <div class="card-header">
            <strong>Datos del cobro</strong>
        </div>

        <div class="card-body">

            <form asp-controller="CuentaCorriente"
                  asp-action="RegistrarCobro"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="CuentaId" type="hidden" />
                <input asp-for="ClienteId" type="hidden" />

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <div class="mb-3">

                    <label asp-for="Importe"
                           class="form-label"></label>

                    <div class="input-group">
                        <span class="input-group-text">$</span>

                        <input asp-for="Importe"
                               type="number"
                               min="0.01"
                               step="0.01"
                               class="form-control" />
                    </div>

                    <span asp-validation-for="Importe"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">

                    <label asp-for="Descripcion"
                           class="form-label"></label>

                    <textarea asp-for="Descripcion"
                              class="form-control"
                              rows="3"
                              placeholder="Ej.: Pago en efectivo"></textarea>

                    <span asp-validation-for="Descripcion"
                          class="text-danger"></span>
                </div>

                <div class="alert alert-info">
                    El importe registrado se descontará
                    de la deuda pendiente del cliente.
                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-success">
                        Confirmar cobro
                    </button>

                    <a asp-controller="CuentaCorriente"
                       asp-action="Detalle"
                       asp-route-clienteId="@Model.ClienteId"
                       class="btn btn-secondary">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
