@model List<SistemaVenta.Application.DTOs.Informes.ClienteTopDto>

@{
    ViewData["Title"] = "Mejores clientes";

    var cultura = System.Globalization.CultureInfo
        .GetCultureInfo("es-AR");

    var fechaDesde = ViewData["FechaDesde"]?.ToString() ?? "";
    var fechaHasta = ViewData["FechaHasta"]?.ToString() ?? "";

    var cantidad = ViewData["Cantidad"] is int valor
        ? valor
        : 10;

    var posicion = 1;
}

<div class="container mt-4">

    <h2 class="mb-2">Mejores clientes</h2>

    <p class="text-muted mb-4">
        Ranking de clientes según el importe total comprado.
    </p>

    <form asp-controller="Informes"
          asp-action="MejoresClientes"
          method="get"
          class="card shadow-sm mb-4">

        <div class="card-body">
            <div class="row g-3 align-items-end">

                <div class="col-md-4">
                    <label for="fechaDesde" class="form-label">
                        Fecha desde
                    </label>

                    <input type="date"
                           id="fechaDesde"
                           name="fechaDesde"
                           value="@fechaDesde"
                           class="form-control"
                           required />
                </div>

                <div class="col-md-4">
                    <label for="fechaHasta" class="form-label">
                        Fecha hasta
                    </label>

                    <input type="date"
                           id="fechaHasta"
                           name="fechaHasta"
                           value="@fechaHasta"
                           class="form-control"
                           required />
                </div>

                <div class="col-md-2">
                    <label for="cantidad" class="form-label">
                        Mostrar
                    </label>

                    <select id="cantidad"
                            name="cantidad"
                            class="form-select">

                        @foreach (var opcion in new[] { 5, 10, 20, 50 })
                        {
                            if (opcion == cantidad)
                            {
                                <option value="@opcion" selected>
                                    Top @opcion
                                </option>
                            }
                            else
                            {
                                <option value="@opcion">
                                    Top @opcion
                                </option>
                            }
                        }

                    </select>
                </div>

                <div class="col-md-2">
                    <button type="submit"
                            class="btn btn-primary w-100">
                        Filtrar
                    </button>
                </div>

            </div>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="card-body">

            <h5 class="card-title mb-3">
                Ranking por facturación
            </h5>

            @if (Model.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    No se encontraron clientes con ventas
                    confirmadas para el período seleccionado.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped
                                      table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Posición</th>
                                <th>Cliente</th>
                                <th class="text-end">
                                    Cantidad de ventas
                                </th>
                                <th class="text-end">
                                    Total comprado
                                </th>
                                <th class="text-end">
                                    Ticket promedio
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var cliente in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@posicion</strong>
                                    </td>

                                    <td>
                                        @cliente.NombreCliente
                                    </td>

                                    <td class="text-end">
                                        @cliente.CantidadVentas
                                    </td>

                                    <td class="text-end">
                                        @cliente.TotalComprado.ToString("C2", cultura)
                                    </td>

                                    <td class="text-end">
                                        @cliente.TicketPromedio.ToString("C2", cultura)
                                    </td>
                                </tr>

                                posicion++;
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>

</div>
