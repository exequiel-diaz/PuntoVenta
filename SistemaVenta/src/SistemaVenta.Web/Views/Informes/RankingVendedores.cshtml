@model List<SistemaVenta.Application.DTOs.Informes.VentaPorVendedorDto>

@{
    ViewData["Title"] = "Ranking de vendedores";

    var cultura = System.Globalization.CultureInfo
        .GetCultureInfo("es-AR");

    var fechaDesde = ViewData["FechaDesde"]?.ToString() ?? "";
    var fechaHasta = ViewData["FechaHasta"]?.ToString() ?? "";

    var criterio = ViewData["Criterio"]?.ToString()
        ?? "facturacion";

    var cantidad = ViewData["Cantidad"] is int valor
        ? valor
        : 10;

    var posicion = 1;
}

<div class="container mt-4">

    <h2 class="mb-2">Ranking de vendedores</h2>

    <p class="text-muted mb-4">
        Consultá el rendimiento comercial de los vendedores.
    </p>

    <!-- FILTROS -->
    <form asp-controller="Informes"
          asp-action="RankingVendedores"
          method="get"
          class="card shadow-sm mb-4">

        <div class="card-body">
            <div class="row g-3 align-items-end">

                <div class="col-md-3">
                    <label for="fechaDesde" class="form-label">
                        Fecha desde
                    </label>

                    <input type="date"
                           id="fechaDesde"
                           name="fechaDesde"
                           value="@fechaDesde"
                           class="form-control"
                           required />
                </div>

                <div class="col-md-3">
                    <label for="fechaHasta" class="form-label">
                        Fecha hasta
                    </label>

                    <input type="date"
                           id="fechaHasta"
                           name="fechaHasta"
                           value="@fechaHasta"
                           class="form-control"
                           required />
                </div>

                <div class="col-md-2">
                    <label for="criterio" class="form-label">
                        Ordenar por
                    </label>

                    <select id="criterio"
                            name="criterio"
                            class="form-select">

                        @if (criterio == "facturacion")
                        {
                            <option value="facturacion" selected>
                                Facturación
                            </option>
                            <option value="cantidad">
                                Cantidad de ventas
                            </option>
                        }
                        else
                        {
                            <option value="facturacion">
                                Facturación
                            </option>
                            <option value="cantidad" selected>
                                Cantidad de ventas
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label for="cantidad" class="form-label">
                        Mostrar
                    </label>

                    <select id="cantidad"
                            name="cantidad"
                            class="form-select">

                        @foreach (var opcion in new[] { 5, 10, 20, 50 })
                        {
                            if (opcion == cantidad)
                            {
                                <option value="@opcion" selected>
                                    Top @opcion
                                </option>
                            }
                            else
                            {
                                <option value="@opcion">
                                    Top @opcion
                                </option>
                            }
                        }

                    </select>
                </div>

                <div class="col-md-2">
                    <button type="submit"
                            class="btn btn-primary w-100">
                        Filtrar
                    </button>
                </div>

            </div>
        </div>
    </form>

    <!-- RESULTADOS -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <div class="d-flex justify-content-between
                        align-items-center mb-3">

                <h5 class="card-title mb-0">
                    Mejores vendedores
                </h5>

                <span class="badge bg-secondary">
                    @(criterio == "facturacion"
                                        ? "Por facturación"
                                        : "Por cantidad de ventas")
                </span>

            </div>

            @if (Model.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    No se encontraron ventas confirmadas
                    con vendedor asignado para este período.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-striped
                                      table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Posición</th>
                                <th>Vendedor</th>
                                <th>Estado</th>
                                <th class="text-end">
                                    Ventas
                                </th>
                                <th class="text-end">
                                    Total vendido
                                </th>
                                <th class="text-end">
                                    Ticket promedio
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var vendedor in Model)
                            {
                                var promedio =
                                vendedor.CantidadVentas > 0
                                ? vendedor.TotalVendido /
                                vendedor.CantidadVentas
                                : 0m;

                                <tr>
                                    <td>
                                        <strong>@posicion</strong>
                                    </td>

                                    <td>
                                        @vendedor.NombreVendedor
                                    </td>

                                    <td>
                                        @if (vendedor.Activo == true)
                                        {
                                            <span class="badge bg-success">
                                                Activo
                                            </span>
                                        }
                                        else if (vendedor.Activo == false)
                                        {
                                            <span class="badge bg-secondary">
                                                Inactivo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark">
                                                Sin información
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        @vendedor.CantidadVentas
                                    </td>

                                    <td class="text-end">
                                        @vendedor.TotalVendido.ToString("C2", cultura)
                                    </td>

                                    <td class="text-end">
                                        @promedio.ToString("C2", cultura)
                                    </td>
                                </tr>

                                posicion++;
                            }
                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

    <a asp-controller="Informes"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Volver a Informes
    </a>

</div>
