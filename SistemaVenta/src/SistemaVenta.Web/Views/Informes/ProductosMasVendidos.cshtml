@model List<SistemaVenta.Application.DTOs.Informes.ProductoMasVendidoDto>

@{
    ViewData["Title"] = "Productos más vendidos";

    var cultura = System.Globalization.CultureInfo.GetCultureInfo("es-AR");

    var fechaDesde = ViewData["FechaDesde"]?.ToString() ?? "";
    var fechaHasta = ViewData["FechaHasta"]?.ToString() ?? "";

    var criterio = ViewData["Criterio"]?.ToString() ?? "cantidad";

    var cantidad = ViewData["Cantidad"] is int valor
        ? valor
        : 10;
}

<div class="container mt-4">

    <h2 class="mb-4">Productos más vendidos</h2>

    <!-- FILTROS -->
    <form asp-controller="Informes"
          asp-action="ProductosMasVendidos"
          method="get"
          class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="row g-3 align-items-end">

                <!-- FECHA DESDE -->
                <div class="col-md-3">
                    <label for="fechaDesde" class="form-label">
                        Fecha desde
                    </label>

                    <input type="date"
                           id="fechaDesde"
                           name="fechaDesde"
                           class="form-control"
                           value="@fechaDesde"
                           required />
                </div>

                <!-- FECHA HASTA -->
                <div class="col-md-3">
                    <label for="fechaHasta" class="form-label">
                        Fecha hasta
                    </label>

                    <input type="date"
                           id="fechaHasta"
                           name="fechaHasta"
                           class="form-control"
                           value="@fechaHasta"
                           required />
                </div>

                <!-- ORDENAMIENTO -->
                <div class="col-md-2">
                    <label for="criterio" class="form-label">
                        Ordenar por
                    </label>

                    <select id="criterio"
                            name="criterio"
                            class="form-select">

                        @if (criterio == "cantidad")
                        {
                            <option value="cantidad" selected>
                                Cantidad
                            </option>
                            <option value="facturacion">
                                Facturación
                            </option>
                        }
                        else
                        {
                            <option value="cantidad">
                                Cantidad
                            </option>
                            <option value="facturacion" selected>
                                Facturación
                            </option>
                        }

                    </select>
                </div>

                <!-- TOP -->
                <div class="col-md-2">
                    <label for="cantidad" class="form-label">
                        Mostrar
                    </label>

                    <select id="cantidad"
                            name="cantidad"
                            class="form-select">

                        @foreach (var opcion in new[] { 5, 10, 20, 50 })
                        {
                            if (opcion == cantidad)
                            {
                                <option value="@opcion" selected>
                                    Top @opcion
                                </option>
                            }
                            else
                            {
                                <option value="@opcion">
                                    Top @opcion
                                </option>
                            }
                        }

                    </select>
                </div>

                <!-- BOTÓN -->
                <div class="col-md-2">
                    <button type="submit"
                            class="btn btn-primary w-100">
                        Filtrar
                    </button>
                </div>

            </div>
        </div>
    </form>

    <!-- RESULTADOS -->
    <div class="card shadow-sm">
        <div class="card-body">

            <div class="d-flex justify-content-between
                        align-items-center mb-3">

                <h5 class="card-title mb-0">
                    Ranking de productos
                </h5>

                <span class="badge bg-secondary">
                    @(criterio == "facturacion"
                                        ? "Por facturación"
                                        : "Por cantidad")
                </span>

            </div>

            @if (Model.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    No se encontraron ventas para el período seleccionado.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-striped table-hover
                                      align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Posición</th>
                                <th>Producto</th>
                                <th class="text-end">
                                    Unidades vendidas
                                </th>
                                <th class="text-end">
                                    Total vendido
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                int posicion = 1;
                            }

                            @foreach (var producto in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@posicion</strong>
                                    </td>

                                    <td>
                                        @producto.NombreProducto
                                    </td>

                                    <td class="text-end">
                                        @producto.UnidadesVendidas.ToString("N0", cultura)
                                    </td>

                                    <td class="text-end">
                                        @producto.TotalVendido.ToString("C2", cultura)
                                    </td>
                                </tr>

                                posicion++;
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>

</div>
