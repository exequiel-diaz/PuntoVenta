@model List<SistemaVenta.Application.DTOs.Informes.ProductoMasVendidoDto>


@{
    ViewData["Title"] = "Productos más vendidos";

    var cultura = System.Globalization.CultureInfo.GetCultureInfo("es-AR");

    var hoy = DateTime.UtcNow.Date;

    var fechaDesde = Context.Request.Query["fechaDesde"].ToString();
    var fechaHasta = Context.Request.Query["fechaHasta"].ToString();
    var cantidadTexto = Context.Request.Query["cantidad"].ToString();

    if (string.IsNullOrWhiteSpace(fechaDesde))
    {
        fechaDesde = hoy.AddDays(-30).ToString("yyyy-MM-dd");
    }

    if (string.IsNullOrWhiteSpace(fechaHasta))
    {
        fechaHasta = hoy.ToString("yyyy-MM-dd");
    }

    var cantidad = int.TryParse(cantidadTexto, out var valor)
        ? valor
        : 10;
}


<div class="container mt-4">

    <h2 class="mb-4">Productos más vendidos</h2>


    <form asp-controller="Informes"
          asp-action="ProductosMasVendidos"
          method="get"
          class="card shadow-sm mb-4">

        <div class="card-body">
            <div class="row g-3 align-items-end">

                <div class="col-md-4">
                    <label for="fechaDesde" class="form-label">
                        Fecha desde
                    </label>

                    <input type="date"
                           id="fechaDesde"
                           name="fechaDesde"
                           class="form-control"
                           value="@fechaDesde"
                           required />
                </div>

                <div class="col-md-4">
                    <label for="fechaHasta" class="form-label">
                        Fecha hasta
                    </label>

                    <input type="date"
                           id="fechaHasta"
                           name="fechaHasta"
                           class="form-control"
                           value="@fechaHasta"
                           required />
                </div>

                <div class="col-md-2">
                    <label for="cantidad" class="form-label">
                        Mostrar
                    </label>


                    <select id="cantidad"
                            name="cantidad"
                            class="form-select">

                        @foreach (var opcion in new[] { 5, 10, 20, 50 })
                        {
                            if (opcion == cantidad)
                            {
                                <option value="@opcion" selected>
                                    Top @opcion
                                </option>
                            }
                            else
                            {
                                <option value="@opcion">
                                    Top @opcion
                                </option>
                            }
                        }

                    </select>

                </div>

                <div class="col-md-2">
                    <button type="submit"
                            class="btn btn-primary w-100">
                        Filtrar
                    </button>
                </div>

            </div>
        </div>
    </form>


    <div class="card shadow-sm">
        <div class="card-body">

            <h5 class="card-title mb-3">
                Ranking de productos
            </h5>

            @if (Model.Count == 0)
            {
                <div class="alert alert-info">
                    No se encontraron ventas para el período seleccionado.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Posición</th>
                                <th>Producto</th>
                                <th class="text-end">Unidades vendidas</th>
                                <th class="text-end">Total vendido</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int posicion = 1;
                            }

                            @foreach (var producto in Model)
                            {
                                <tr>
                                    <td>@posicion</td>
                                    <td>@producto.NombreProducto</td>
                                    <td class="text-end">
                                        @producto.UnidadesVendidas.ToString("N2", cultura)
                                    </td>
                                    <td class="text-end">
                                        @producto.TotalVendido.ToString("C2", cultura)
                                    </td>
                                </tr>

                                posicion++;
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>

</div>
