@model List<SistemaVenta.Application.DTOs.Informes.InventarioProductoDto>

@{
    ViewData["Title"] = "Inventario actual";

    var cultura = new System.Globalization.CultureInfo("es-AR");

    var totalProductos = Model.Count;
    var sinStock = Model.Count(p => p.StockActual == 0);
    var stockBajo = Model.Count(p =>
        p.StockActual > 0 &&
        p.StockActual <= p.StockMinimo);

    var valorPotencial = Model.Sum(p => p.ValorPotencialVenta);
}


<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Inventario actual</h2>

    <a asp-controller="Informes"
       asp-action="DescargarInventarioActualPdf"
       class="btn btn-success">
        Descargar PDF
    </a>
</div>


<p class="text-muted">
    Estado del inventario al momento de realizar la consulta.
</p>

<div class="row g-3 mb-4">

    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <h6>Productos activos</h6>
                <h3>@totalProductos</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-danger h-100">
            <div class="card-body">
                <h6>Sin stock</h6>
                <h3 class="text-danger">@sinStock</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-warning h-100">
            <div class="card-body">
                <h6>Stock bajo</h6>
                <h3 class="text-warning">@stockBajo</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <h6>Valor potencial de venta</h6>
                <h3>
                    @valorPotencial.ToString("C2", cultura)
                </h3>
            </div>
        </div>
    </div>

</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No hay productos activos para mostrar.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">

            <thead>
                <tr>
                    <th>Código</th>
                    <th>Producto</th>
                    <th>Categoría</th>
                    <th class="text-end">Stock</th>
                    <th class="text-end">Mínimo</th>
                    <th class="text-end">Precio venta</th>
                    <th class="text-end">Valor potencial</th>
                    <th>Estado</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var producto in Model)
                {
                    <tr>
                        <td>@producto.CodigoInterno</td>
                        <td>@producto.Nombre</td>
                        <td>@producto.Categoria</td>

                        <td class="text-end">
                            @producto.StockActual.ToString("N0", cultura)
                        </td>

                        <td class="text-end">
                            @producto.StockMinimo.ToString("N0", cultura)
                        </td>

                        <td class="text-end">
                            @producto.PrecioVenta.ToString("C2", cultura)
                        </td>

                        <td class="text-end">
                            @producto.ValorPotencialVenta.ToString("C2", cultura)
                        </td>

                        <td>
                            @if (producto.StockActual == 0)
                            {
                                <span class="badge bg-danger">
                                    Sin stock
                                </span>
                            }
                            else if (producto.StockActual <= producto.StockMinimo)
                            {
                                <span class="badge bg-warning text-dark">
                                    Stock bajo
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    Normal
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
}

<p class="text-muted small">
    El valor potencial se calcula con el precio de venta
    actual. No representa el costo de adquisición del inventario.
</p>

<a asp-controller="Informes"
   asp-action="Index"
   class="btn btn-secondary">
    Volver a informes
</a>
